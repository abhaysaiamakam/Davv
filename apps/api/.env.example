# CropLens API Configuration
PROJECT_NAME="CropLens API"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Local Frontend CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage Directory (Optional: defaults to apps/api/storage_data)
# CROPLENS_STORAGE_BASE_DIR=/absolute/path/to/storage_data
# CROPLENS_CURATED_DATASETS_DIR=/path/to/curated_datasets_folder

