# ===================================
# CropLens Monorepo Configuration
# ===================================

# Frontend Web Client
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend FastAPI Service
PROJECT_NAME="CropLens API"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional Storage Directory Override (Defaults to apps/api/storage_data)
# CROPLENS_STORAGE_BASE_DIR=/absolute/path/to/storage_data

# Optional External Curated Datasets Directory
# CROPLENS_CURATED_DATASETS_DIR=/path/to/curated_datasets_folder

